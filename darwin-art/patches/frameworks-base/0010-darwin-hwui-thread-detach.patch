 };
+
 static JavaVM* mJvm = nullptr;
+#if defined(__APPLE__)
+static pthread_key_t gArtThreadKey;
+static pthread_once_t gArtThreadKeyOnce = PTHREAD_ONCE_INIT;
+static bool debugJniAttach() {
+    return std::getenv("DARWIN_ART_DEBUG_JNI_ATTACH") != nullptr;
+}
+static void detachArtThread(void*) {
+    if (mJvm != nullptr) {
+        const jint result = mJvm->DetachCurrentThread();
+        if (debugJniAttach()) {
+            std::fprintf(stderr, "ART HWUI JNI detach tid=%p result=%d owned=1\n",
+                         reinterpret_cast<void*>(pthread_self()), result);
+        }
+    }
+}
+static void initArtThreadKey() {
+    const int result = pthread_key_create(&gArtThreadKey, &detachArtThread);
+    if (debugJniAttach()) {
+        std::fprintf(stderr, "ART HWUI JNI key-create tid=%p result=%d\n",
+                     reinterpret_cast<void*>(pthread_self()), result);
+    }
+}
+#endif
 
 static void attachRenderThreadToJvm(const char* name) {
     LOG_ALWAYS_FATAL_IF(!mJvm, "No jvm but we set the hook??");
@@ -1085,5 +1100,28 @@

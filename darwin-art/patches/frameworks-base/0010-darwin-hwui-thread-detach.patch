@@ -42,6 +42,11 @@
 #include <media/NdkImage.h>
 #include <media/NdkImageReader.h>
 #include <nativehelper/JNIPlatformHelp.h>
+#if defined(__APPLE__)
+#include <pthread.h>
+#include <cstdio>

+        }
+#endif
+        return;
+    }
+    LOG_ALWAYS_FATAL_IF(state != JNI_EDETACHED, "Unexpected JavaVM GetEnv result: %d", state);
+    LOG_ALWAYS_FATAL_IF(mJvm->AttachCurrentThreadAsDaemon(&env, (void*) &args) != JNI_OK,

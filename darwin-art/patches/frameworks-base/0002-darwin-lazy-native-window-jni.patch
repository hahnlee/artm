+static ANW_fromSurface requireFromSurface() {
+    static ANW_fromSurface resolved = []() {
+        void* handle = SharedLib::openSharedLib("libandroid_runtime");
+        LOG_ALWAYS_FATAL_IF(handle == nullptr,
+                            "libandroid_runtime.dylib is unavailable for hardware Surface use");

diff --git a/ojluni/src/main/native/FileDescriptor_md.c b/ojluni/src/main/native/FileDescriptor_md.c
index a838507e1..000000000 100644
--- a/ojluni/src/main/native/FileDescriptor_md.c
+++ b/ojluni/src/main/native/FileDescriptor_md.c
@@ -25,6 +25,22 @@
 #include <sys/socket.h>
 #include <sys/types.h>

+#if defined(__APPLE__)
+#include <errno.h>
+#include <fcntl.h>
+
+// Bionic supplies TEMP_FAILURE_RETRY. Darwin does not, but the Android
+// FileDescriptor contract still requires retrying interrupted descriptor
+// queries rather than translating EINTR into a false result.
+#ifndef TEMP_FAILURE_RETRY
+#define TEMP_FAILURE_RETRY(expression)          \
+    ({ __typeof__(expression) result;           \
+       do { result = (expression); }            \
+       while (result == -1 && errno == EINTR);  \
+       result; })
+#endif
+#endif
+
 #include "jni.h"
 #include "jni_util.h"
 #include "jvm.h"
@@ -61,11 +77,20 @@ FileDescriptor_sync(JNIEnv *env, jobject this) {
 }

 JNIEXPORT jboolean JNICALL FileDescriptor_isSocket(jint fd) {
+#if defined(__APPLE__)
+    // Darwin has no SO_DOMAIN. SO_TYPE has the same property needed by this
+    // predicate: getsockopt succeeds for sockets and fails for other fds.
+    int socket_type;
+    socklen_t socket_type_length = sizeof(socket_type);
+    return TEMP_FAILURE_RETRY(getsockopt(fd, SOL_SOCKET, SO_TYPE, &socket_type,
+                                        &socket_type_length)) == 0;
+#else
     // BEGIN Android-changed: isSocket - do not clear socket error code
     int domain;
     socklen_t domain_length = sizeof(domain);
     return TEMP_FAILURE_RETRY(getsockopt(fd, SOL_SOCKET, SO_DOMAIN, &domain, &domain_length)) == 0;
     // END Android-changed: isSocket - do not clear socket error code
+#endif
 }

 JNIEXPORT jboolean JNICALL

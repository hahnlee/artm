--- a/openjdkjvm/OpenjdkJvm.cc
+++ b/openjdkjvm/OpenjdkJvm.cc
@@ -160,7 +160,19 @@ JNIEXPORT char* JVM_NativePath(char* path) {
 }
 
 JNIEXPORT jint JVM_GetLastErrorString(char* buf, int len) {
-#if defined(__GLIBC__) || defined(__BIONIC__)
+#if defined(__APPLE__)
+  if (len <= 0) {
+    return 0;
+  }
+
+  const int err = errno;
+  if (strerror_r(err, buf, static_cast<size_t>(len)) != 0) {
+    buf[0] = '\0';
+    return 0;
+  }
+  buf[len - 1] = '\0';
+  return static_cast<jint>(strlen(buf));
+#elif defined(__GLIBC__) || defined(__BIONIC__)
   if (len == 0) {
     return 0;
   }

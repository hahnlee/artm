diff --git a/runtime/runtime.cc b/runtime/runtime.cc
--- a/runtime/runtime.cc
+++ b/runtime/runtime.cc
@@ -1056,7 +1056,31 @@ void Runtime::FinishMinimalForDarwinProbe() {
   if (jit_options_->UseJitCompilation() || jit_options_->GetSaveProfilingInfo()) {
     CreateJit();
   }
-  StartDaemonThreads();
+  // Preserve Runtime::Start's JVMTI phase ordering around daemon startup.
+  // Startup agents observe VMStart only after the main Thread peer exists,
+  // and VMInit only after daemon creation can no longer be delayed by agent
+  // callbacks.
+  {
+    ScopedObjectAccess soa(self);
+    callbacks_->NextRuntimePhase(RuntimePhaseCallback::RuntimePhase::kStart);
+  }
+  // A detached Darwin application is already a non-zygote app process. Run
+  // the same post-fork initialization as app_process: reset GC metrics,
+  // configure/start the metrics reporter, and publish the Signal Catcher.
+  if (!is_zygote_) {
+    InitNonZygoteOrPostFork(self->GetJniEnv(),
+                            /*is_system_server=*/false,
+                            /*is_child_zygote=*/false,
+                            NativeBridgeAction::kUnload,
+                            GetInstructionSetString(kRuntimeISA));
+  }
+  {
+    ScopedObjectAccess soa(self);
+    StartDaemonThreads();
+    self->GetJniEnv()->AssertLocalsEmpty();
+    callbacks_->NextRuntimePhase(RuntimePhaseCallback::RuntimePhase::kInit);
+    self->GetJniEnv()->AssertLocalsEmpty();
+  }
   finished_starting_ = true;
 }
 #endif

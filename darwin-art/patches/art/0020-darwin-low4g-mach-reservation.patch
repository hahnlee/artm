@@ -263,5 +268,29 @@ void* MemMap::TryMemMapLow4GB(void* ptr,
                                     int flags,
                                     int fd,
                                     off_t offset) {
+#if defined(__APPLE__)
+  // Darwin ignores ordinary low address hints on arm64. Reserve the exact
+  // range with Mach first; VM_FLAGS_FIXED fails rather than overwriting an
+  // existing mapping. MAP_FIXED then replaces only our own reservation.
+  mach_vm_address_t reservation = reinterpret_cast<mach_vm_address_t>(ptr);
+  kern_return_t result = mach_vm_allocate(mach_task_self(),
+                                          &reservation,
+                                          page_aligned_byte_count,
+                                          VM_FLAGS_FIXED);
+  if (result != KERN_SUCCESS) {
+    errno = ENOMEM;
+    return MAP_FAILED;
+  }
+  void* actual = TargetMMap(ptr,
+                            page_aligned_byte_count,
+                            prot,
+                            flags | MAP_FIXED,
+                            fd,
+                            offset);
+  if (actual == MAP_FAILED) {
+    mach_vm_deallocate(mach_task_self(), reservation, page_aligned_byte_count);
+  }
+  return actual;
+#else
   void* actual = TargetMMap(ptr, page_aligned_byte_count, prot, flags, fd, offset);
   if (actual != MAP_FAILED) {
@@ -275,6 +304,7 @@ void* MemMap::TryMemMapLow4GB(void* ptr,
     }
   }
   return actual;
+#endif
 }

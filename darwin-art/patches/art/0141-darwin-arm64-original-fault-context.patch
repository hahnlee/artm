+void DumpDarwinOriginalFaultContext(siginfo_t* siginfo, void* context) {
+  // This runs only after ART's generated-code handlers declined the signal.
+  // Keep it async-signal-safe so a transient JNI frame cannot hide the first
+  // failure behind a fault in stack walking or symbolization.
+  char line[768];
+  size_t used = 0u;
+  constexpr char prefix[] = "ART original generated-code fault";
+  for (size_t index = 0u; index != sizeof(prefix) - 1u; ++index) {
+    line[used++] = prefix[index];
+  }
+  auto append_hex = [&](const char* label, uintptr_t value) {
+    while (*label != '\0') line[used++] = *label++;
+    for (int shift = static_cast<int>(sizeof(value) * 8u) - 4; shift >= 0; shift -= 4) {
+      const unsigned digit = (value >> shift) & 0xfu;
+      line[used++] = digit < 10u ? '0' + digit : 'a' + digit - 10u;
+    }
+  };
+  arm_thread_state64_t& state =
+      reinterpret_cast<ucontext_t*>(context)->uc_mcontext->__ss;
+  append_hex(" pc=0x", arm_thread_state64_get_pc(state));
+#if __DARWIN_OPAQUE_ARM_THREAD_STATE64
+  append_hex(" raw_pc=0x", reinterpret_cast<uintptr_t>(state.__opaque_pc));
+  append_hex(" raw_lr=0x", reinterpret_cast<uintptr_t>(state.__opaque_lr));
+  append_hex(" flags=0x", state.__opaque_flags);
+#else
+  append_hex(" raw_pc=0x", state.__pc);
+  append_hex(" raw_lr=0x", state.__lr);
+#endif
+  if (getenv("DARWIN_ART_DEBUG_FAULT_MAP") != nullptr) {
+    mach_vm_address_t region =
+        static_cast<mach_vm_address_t>(arm_thread_state64_get_pc(state));
+    mach_vm_size_t region_size = 0;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object = MACH_PORT_NULL;
+    const kern_return_t kr = mach_vm_region(
+        mach_task_self(), &region, &region_size, VM_REGION_BASIC_INFO_64,
+        reinterpret_cast<vm_region_info_t>(&info), &count, &object);
+    append_hex(" fault_map_kr=0x", static_cast<uintptr_t>(kr));
+    append_hex(" fault_map_base=0x", static_cast<uintptr_t>(region));
+    append_hex(" fault_map_size=0x", static_cast<uintptr_t>(region_size));
+    append_hex(" fault_map_prot=0x", static_cast<uintptr_t>(
+        kr == KERN_SUCCESS ? info.protection : 0));
+    append_hex(" fault_map_max=0x", static_cast<uintptr_t>(
+        kr == KERN_SUCCESS ? info.max_protection : 0));
+  }
+  append_hex(" sp=0x", arm_thread_state64_get_sp(state));
+  append_hex(" lr=0x", arm_thread_state64_get_lr(state));
+  if (getenv("DARWIN_ART_DEBUG_FAULT_MAP") != nullptr) {
+    uintptr_t image_start = 0;
+    uintptr_t image_end = 0;
+    if (darwin_art_unwindstack_lookup_image(arm_thread_state64_get_pc(state), &image_start,
+                                            &image_end)) {
+      append_hex(" image_start=0x", image_start);
+      append_hex(" image_end=0x", image_end);
+    }
+    image_start = 0;
+    image_end = 0;
+    if (darwin_art_unwindstack_lookup_image(arm_thread_state64_get_lr(state), &image_start,
+                                            &image_end)) {
+      append_hex(" lr_image_start=0x", image_start);
+      append_hex(" lr_image_end=0x", image_end);
+    }
+    const mach_vm_address_t lr =
+        static_cast<mach_vm_address_t>(arm_thread_state64_get_lr(state));
+    uint32_t words[4] = {};
+    mach_vm_size_t copied = 0;
+    const mach_vm_address_t start = lr >= 16u ? lr - 16u : lr;
+    const kern_return_t read_kr = mach_vm_read_overwrite(
+        mach_task_self(), start, sizeof(words),
+        reinterpret_cast<mach_vm_address_t>(words), &copied);
+    append_hex(" lr_read_kr=0x", static_cast<uintptr_t>(read_kr));
+    if (read_kr == KERN_SUCCESS && copied == sizeof(words)) {
+      append_hex(" lr_m16=0x", words[0]);
+      append_hex(" lr_m12=0x", words[1]);
+      append_hex(" lr_m8=0x", words[2]);
+      append_hex(" lr_m4=0x", words[3]);
+    }
+  }
+  append_hex(" addr=0x", reinterpret_cast<uintptr_t>(siginfo->si_addr));
+  append_hex(" code=0x", static_cast<uintptr_t>(siginfo->si_code));
+  for (size_t index = 0u; index <= 8u; ++index) {
+    char label[] = " x0=0x";
+    label[2] = '0' + index;
+    append_hex(label, state.__x[index]);
+  }
+  for (size_t index = 15u; index <= 21u; ++index) {
+    char label[] = " x00=0x";
+    label[2] = '0' + index / 10u;
+    label[3] = '0' + index % 10u;
+    append_hex(label, state.__x[index]);
+  }
+  for (size_t index = 22u; index <= 27u; ++index) {
+    char label[] = " x00=0x";
+    label[2] = '0' + index / 10u;
+    label[3] = '0' + index % 10u;
+    append_hex(label, state.__x[index]);
+  }
+  append_hex(" x28=0x", state.__x[28]);
+  append_hex(" jit_write_depth=0x", DarwinArtJitWriteDepth());
+  line[used++] = '\n';
+  const ssize_t ignored = write(STDERR_FILENO, line, used);
+  (void)ignored;
+}

+#if defined(__APPLE__) && defined(__aarch64__)
+void DumpDarwinOriginalFaultContext(siginfo_t* siginfo, void* context) {
+  // This runs only after ART's generated-code handlers declined the signal.
+  // Keep it async-signal-safe so a transient JNI frame cannot hide the first
+  // failure behind a fault in stack walking or symbolization.
+  char line[768];
+  size_t used = 0u;
+  constexpr char prefix[] = "ART original generated-code fault";
+  for (size_t index = 0u; index != sizeof(prefix) - 1u; ++index) {
+    line[used++] = prefix[index];
+  }
+  auto append_hex = [&](const char* label, uintptr_t value) {
+    while (*label != '\0') line[used++] = *label++;
+    for (int shift = static_cast<int>(sizeof(value) * 8u) - 4; shift >= 0; shift -= 4) {
+      const unsigned digit = (value >> shift) & 0xfu;
+      line[used++] = digit < 10u ? '0' + digit : 'a' + digit - 10u;
+    }
+  };
+  arm_thread_state64_t& state =
+      reinterpret_cast<ucontext_t*>(context)->uc_mcontext->__ss;
+  append_hex(" pc=0x", arm_thread_state64_get_pc(state));
+  append_hex(" sp=0x", arm_thread_state64_get_sp(state));
+  append_hex(" lr=0x", arm_thread_state64_get_lr(state));
+  append_hex(" addr=0x", reinterpret_cast<uintptr_t>(siginfo->si_addr));
+  append_hex(" code=0x", static_cast<uintptr_t>(siginfo->si_code));
+  for (size_t index = 0u; index <= 8u; ++index) {
+    char label[] = " x0=0x";
+    label[2] = '0' + index;
+    append_hex(label, state.__x[index]);
+  }
+  for (size_t index = 15u; index <= 21u; ++index) {
+    char label[] = " x00=0x";
+    label[2] = '0' + index / 10u;
+    label[3] = '0' + index % 10u;
+    append_hex(label, state.__x[index]);
+  }
+  append_hex(" x28=0x", state.__x[28]);
+  line[used++] = '\n';
+  const ssize_t ignored = write(STDERR_FILENO, line, used);
+  (void)ignored;
+}
+#endif

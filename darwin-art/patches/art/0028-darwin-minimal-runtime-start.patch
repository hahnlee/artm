diff --git a/runtime/runtime.h b/runtime/runtime.h
--- a/runtime/runtime.h
+++ b/runtime/runtime.h
@@ -272,0 +273,8 @@
+#if defined(__APPLE__)
+  // Enable normal managed/native dispatch and register ART's own native
+  // methods without loading Android's libcore JNI libraries or starting
+  // daemon threads.
+  void StartMinimalForDarwinProbe(JNIEnv* env);
+  void FinishMinimalForDarwinProbe();
+#endif
+
diff --git a/runtime/runtime.cc b/runtime/runtime.cc
--- a/runtime/runtime.cc
+++ b/runtime/runtime.cc
@@ -1037,0 +1038,18 @@
+#if defined(__APPLE__)
+void Runtime::StartMinimalForDarwinProbe(JNIEnv* env) {
+  CHECK(!started_);
+  Thread* self = Thread::Current();
+  started_ = true;
+  RegisterRuntimeNativeMethods(env);
+  class_linker_->RunEarlyRootClinits(self);
+  InitializeIntrinsics();
+}
+
+void Runtime::FinishMinimalForDarwinProbe() {
+  CHECK(started_);
+  Thread* self = Thread::Current();
+  InitThreadGroups(self);
+  Thread::FinishStartup();
+}
+#endif
+

diff --git a/runtime/runtime.cc b/runtime/runtime.cc
--- a/runtime/runtime.cc
+++ b/runtime/runtime.cc
@@ -1047,7 +1047,5 @@ void Runtime::StartMinimalForDarwinProbe(JNIEnv* env) {
   Thread* self = Thread::Current();
   started_ = true;
   RegisterRuntimeNativeMethods(env);
-  class_linker_->RunEarlyRootClinits(self);
-  InitializeIntrinsics();
 
   // Android's Runtime::InitNativeMethods loads libopenjdk as a boot
@@ -1080,6 +1078,19 @@ void Runtime::FinishMinimalForDarwinProbe() {
   CHECK(started_);
   CHECK(!finished_starting_);
   Thread* self = Thread::Current();
+  // Android's boot image normally carries the early roots in an initialized
+  // state before libcore JNI startup.  The detached Darwin image is smaller,
+  // so an early root can transitively initialize System and call Linux.getenv.
+  // The launcher has installed the equivalent libcore JNI tables between the
+  // minimal start and finish phases; initialize the roots only after that
+  // ownership exists. Keep the upstream root-clinit/intrinsics ordering
+  // together. StartMinimal leaves this thread in kNative after loading the
+  // named-JNI owner, so reacquire runnable/mutator access here.
+  {
+    ScopedObjectAccess soa(self);
+    class_linker_->RunEarlyRootClinits(self);
+    InitializeIntrinsics();
+  }
   // Match Runtime::Start ordering after boot JNI ownership has been
   // established by StartMinimalForDarwinProbe() and the Darwin registrars.
   WellKnownClasses::LateInit(self->GetJniEnv());

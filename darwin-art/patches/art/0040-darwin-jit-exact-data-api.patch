diff --git a/runtime/jit/jit_memory_region.cc b/runtime/jit/jit_memory_region.cc
--- a/runtime/jit/jit_memory_region.cc
+++ b/runtime/jit/jit_memory_region.cc
@@ -122,10 +123,31 @@
     if (!exec_pages.IsValid()) {
       *error_msg = "Failed to create Darwin MAP_JIT code cache: " + error_str;
       return false;
     }
-    data_pages = MemMap::MapAnonymous(data_cache_name.c_str(), nullptr,
-                                      data_capacity, kProtRW, false, false,
-                                      nullptr, &error_str);
+    const size_t rounded_data = RoundUp(data_capacity, MemMap::GetPageSize());
+    const uintptr_t exec_base = reinterpret_cast<uintptr_t>(exec_pages.Begin());
+    // Mach-O binaries reserve the complete low 4GiB (__PAGEZERO). Keep the
+    // AOSP ordering (data below executable) while never probing that region.
+    constexpr uintptr_t kDarwinPageZeroEnd = UINT64_C(0x100000000);
+    if (exec_base >= kDarwinPageZeroEnd &&
+        rounded_data <= exec_base - kDarwinPageZeroEnd) {
+      data_pages = MemMap::MapAnonymousExact(data_cache_name.c_str(),
+                                             reinterpret_cast<uint8_t*>(kDarwinPageZeroEnd),
+                                             data_capacity, kProtRW, &error_str);
+    }
+    for (size_t attempt = 0; attempt != 128 && !data_pages.IsValid(); ++attempt) {
+      const uintptr_t delta = rounded_data * (attempt + 1);
+      if (exec_base < delta) {
+        break;
+      }
+      const uintptr_t candidate = exec_base - delta;
+      if (candidate < kDarwinPageZeroEnd) {
+        break;
+      }
+      data_pages = MemMap::MapAnonymousExact(data_cache_name.c_str(),
+                                             reinterpret_cast<uint8_t*>(candidate),
+                                             data_capacity, kProtRW, &error_str);
+    }
     if (!data_pages.IsValid()) {
       exec_pages.Reset();
       *error_msg = "Failed to map Darwin JIT data cache: " + error_str;

diff --git a/runtime/runtime.cc b/runtime/runtime.cc
--- a/runtime/runtime.cc
+++ b/runtime/runtime.cc
@@ -22,5 +22,7 @@
 #if defined(__APPLE__)
 #include <crt_externs.h>  // for _NSGetEnviron
+#include <dlfcn.h>
+#include <limits.h>
 #endif
 
 #include <android-base/properties.h>
@@ -1042,8 +1044,44 @@
 void Runtime::StartMinimalForDarwinProbe(JNIEnv* env) {
   CHECK(!started_);
   Thread* self = Thread::Current();
   started_ = true;
   RegisterRuntimeNativeMethods(env);
   class_linker_->RunEarlyRootClinits(self);
   InitializeIntrinsics();
+
+  // Android's Runtime::InitNativeMethods loads libopenjdk as a boot
+  // ClassLoader library through JavaVMExt. The Darwin launcher keeps the
+  // aggregate runtime image out of that library table: it contains framework
+  // and test JNI entrypoints which must never be candidates for boot lookup.
+  // The sibling image is the dedicated RTLD_LOCAL owner for only the AOSP
+  // OpenJDK Java_* named-lookup surface.
+  Dl_info image_info{};
+  const void* runtime_entry = reinterpret_cast<const void*>(
+      reinterpret_cast<uintptr_t>(Runtime::Current));
+  CHECK_NE(dladdr(runtime_entry, &image_info), 0);
+  CHECK(image_info.dli_fname != nullptr);
+  char image_path[PATH_MAX];
+  CHECK(realpath(image_info.dli_fname, image_path) != nullptr);
+  // JavaVMExt requires JNI_OnLoad to run from the native thread state, just as
+  // Runtime::InitNativeMethods does on Android. Keep all managed setup above
+  // runnable, then enter kNative before invoking the loader.
+  self->TransitionFromRunnableToSuspended(ThreadState::kNative);
+  jclass java_lang_Object;
+  {
+    ScopedObjectAccess soa(self);
+    java_lang_Object = reinterpret_cast<jclass>(
+        GetJavaVM()->AddGlobalRef(self, GetClassRoot<mirror::Object>(GetClassLinker())));
+  }
+  const std::string runtime_path(image_path);
+  const size_t separator = runtime_path.find_last_of('/');
+  CHECK_NE(separator, std::string::npos);
+  const std::string named_jni_path =
+      runtime_path.substr(0, separator) + "/libopenjdk-named-jni-owner.dylib";
+  std::string error_msg;
+  if (!java_vm_->LoadNativeLibrary(env, named_jni_path, nullptr, java_lang_Object,
+                                   &error_msg)) {
+    LOG(FATAL) << "LoadNativeLibrary failed for dedicated OpenJDK named-JNI owner: "
+               << error_msg;
+  }
+  env->DeleteGlobalRef(java_lang_Object);
 }

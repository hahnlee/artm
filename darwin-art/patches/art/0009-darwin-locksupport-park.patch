diff --git a/runtime/thread.cc b/runtime/thread.cc
--- a/runtime/thread.cc
+++ b/runtime/thread.cc
@@ -404,14 +404,57 @@ void Thread::Park(bool is_absolute, int64_t time) {
   } else {
     DCHECK_EQ(old_state, kPermitAvailable);
   }
-#else
-  #pragma clang diagnostic push
-  #pragma clang diagnostic warning "-W#warnings"
-  #warning "LockSupport.park/unpark implemented as noops without FUTEX support."
-  #pragma clang diagnostic pop
-  UNUSED(is_absolute, time);
-  UNIMPLEMENTED(WARNING);
-  sched_yield();
+#elif defined(__APPLE__)
+  int old_state = tls32_.park_state_.fetch_add(1, std::memory_order_relaxed);
+  if (old_state == kNoPermit) {
+    Runtime::Current()->GetRuntimeCallbacks()->ThreadParkStart(is_absolute, time);
+    bool timed_out = false;
+    if (!is_absolute && time == 0) {
+      ScopedThreadSuspension sts(this, ThreadState::kWaiting);
+      DCHECK_EQ(NumberOfHeldMutexes(), 0u);
+      MutexLock mu(this, *park_mutex_);
+      if (tls32_.park_state_.load(std::memory_order_relaxed) == kNoPermitWaiterWaiting) {
+        park_cond_->Wait(this);
+      }
+      tls32_.park_state_.store(kNoPermit, std::memory_order_relaxed);
+    } else if (time > 0) {
+      ScopedThreadSuspension sts(this, ThreadState::kTimedWaiting);
+      DCHECK_EQ(NumberOfHeldMutexes(), 0u);
+      MutexLock mu(this, *park_mutex_);
+      if (tls32_.park_state_.load(std::memory_order_relaxed) == kNoPermitWaiterWaiting) {
+        int64_t wait_ms;
+        int32_t wait_ns;
+        if (is_absolute) {
+          uint64_t now_ms = MilliTime();
+          uint64_t deadline_ms = static_cast<uint64_t>(time);
+          if (deadline_ms <= now_ms) {
+            wait_ms = 0;
+            wait_ns = 0;
+            timed_out = true;
+          } else {
+            wait_ms = static_cast<int64_t>(deadline_ms - now_ms);
+            wait_ns = 0;
+          }
+        } else {
+          wait_ms = time / INT64_C(1000000);
+          wait_ns = static_cast<int32_t>(time % INT64_C(1000000));
+        }
+        if (!timed_out) {
+          timed_out = park_cond_->TimedWait(this, wait_ms, wait_ns);
+        }
+      }
+      tls32_.park_state_.store(kNoPermit, std::memory_order_relaxed);
+    } else {
+      MutexLock mu(this, *park_mutex_);
+      tls32_.park_state_.store(kNoPermit, std::memory_order_relaxed);
+    }
+    Runtime::Current()->GetRuntimeCallbacks()->ThreadParkFinished(timed_out);
+  } else {
+    DCHECK_EQ(old_state, kPermitAvailable);
+  }
+#else
+  UNUSED(is_absolute, time);
+  UNIMPLEMENTED(FATAL);
 #endif
 }
 

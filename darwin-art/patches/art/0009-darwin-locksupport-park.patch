diff --git a/runtime/thread.h b/runtime/thread.h
--- a/runtime/thread.h
+++ b/runtime/thread.h
@@ -2443,5 +2443,12 @@ class EXPORT Thread {
   // Pointer to the monitor lock we're currently waiting on or null if not waiting.
   Monitor* wait_monitor_ GUARDED_BY(wait_mutex_);
 
+#if defined(__APPLE__)
+  // Darwin has no futex. Keep LockSupport's permit state machine, but sleep on
+  // a per-thread pthread-backed ART condition variable.
+  Mutex* park_mutex_ DEFAULT_MUTEX_ACQUIRED_AFTER;
+  ConditionVariable* park_cond_ GUARDED_BY(park_mutex_);
+#endif
+
   // Debug disable read barrier count, only is checked for debug builds and only in the runtime.

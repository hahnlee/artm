#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
ctl="$root/target/release/darwin-artctl"
require_build() {
  [[ -x "$ctl" ]] || {
    echo "Darwin ART is not built; run cargo xtask build once" >&2
    exit 69
  }
}
command="${1:-}"
case "$command" in
  install)
    apk="${2:-}"
    [[ -n "$apk" ]] || {
      echo "usage: darwin-art install APK" >&2
      exit 64
    }
    DARWIN_ART_INSTALL_ONLY=1 "$root/tools/run-android-apk-app.sh" "$apk" 0
    ;;
  run)
    package="${2:-}"
    seconds="${3:-86400}"
    [[ -n "$package" ]] || {
      echo "usage: darwin-art run PACKAGE [VISIBLE_SECONDS]" >&2
      exit 64
    }
    require_build
    mount="$($ctl ensure)"
    record="$(mktemp "$mount/run/resolved-launch.XXXXXX")"
    cleanup() { rm -f "$record"; }
    trap cleanup EXIT
    "$ctl" resolve "$package" >"$record"
    "$root/tools/run-android-apk-app.sh" --record "$record" "$seconds"
    ;;
  list)
    require_build
    "$ctl" ensure >/dev/null
    "$ctl" list
    ;;
  ps)
    require_build
    "$ctl" ensure >/dev/null
    "$ctl" ps
    ;;
  *)
    echo "usage: darwin-art {install APK|run PACKAGE [VISIBLE_SECONDS]|list|ps}" >&2
    exit 64
    ;;
esac
